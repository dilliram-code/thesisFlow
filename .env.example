# Google Gemini API Key (Required for AI deconstruction, chat assistant, and RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.8-flash (recommended) or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional: Embedding model for semantic search (defaults to gemini-embedding-001 or local fallback)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# App Settings
THESISFLOW_ENV=development
MAX_UPLOAD_SIZE_MB=35
MAX_PAGES_TO_PROCESS=100
DEFAULT_THEME=dark

